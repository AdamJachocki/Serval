@page
@model LoginModel
@{
    ViewData["Title"] = "Logowanie";
    var hasErrors = !ViewData.ModelState.IsValid || Model.Error is not null;
}

<div class="login-shell">
    <section class="login-art" aria-hidden="true">
        <div class="login-art__brand"><partial name="_Brand" /></div>
        <p class="login-art__tagline">Twój serwer.<br /><strong>Jasny obraz.</strong></p>
    </section>
    <section class="login-panel" aria-labelledby="login-title">
        <div class="login-card">
            <div class="login-card__brand"><partial name="_Brand" /></div>
            <h1 id="login-title">Zaloguj się</h1>
            <p class="page-lead">Użyj konta systemowego Linux.</p>
            @if (hasErrors)
            {
                <div class="alert alert--danger" role="alert" tabindex="-1" data-error-summary>
                    @if (Model.Error is not null)
                    {
                        <p>@Model.Error</p>
                    }
                    <div asp-validation-summary="All"></div>
                </div>
            }
            <form method="post" data-login-form>
                <div class="form-field">
                    <label asp-for="Username"></label>
                    <input asp-for="Username" autocomplete="username" aria-describedby="username-error" />
                    <span id="username-error" asp-validation-for="Username" class="field-error"></span>
                </div>
                <div class="form-field">
                    <label asp-for="Password"></label>
                    <div class="password-field">
                        <input asp-for="Password" type="password" autocomplete="current-password" aria-describedby="password-error" data-password-input />
                        <button type="button" class="password-toggle" aria-label="Pokaż hasło" aria-pressed="false" hidden data-password-toggle>
                            <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M2.5 12s3.5-6 9.5-6 9.5 6 9.5 6-3.5 6-9.5 6-9.5-6-9.5-6zM12 9a3 3 0 100 6 3 3 0 000-6z" /></svg>
                        </button>
                    </div>
                    <span id="password-error" asp-validation-for="Password" class="field-error"></span>
                </div>
                <button class="button button--primary button--login" type="submit" data-login-submit data-pending-label="Logowanie…">Zaloguj się</button>
                <p class="pending-message" role="status" aria-live="polite" data-login-status></p>
            </form>
        </div>
    </section>
</div>
