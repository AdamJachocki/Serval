@page
@model Serval.Web.Pages.Grants.IndexModel
@{
    ViewData["Title"] = "Uprawnienia";
    ViewData["Breadcrumb"] = "Uprawnienia";
}

<header class="page-header">
    <div>
        <h1>Uprawnienia do usług</h1>
        <p class="page-lead">Zarządzaj dostępem kont i grup systemu Linux do odczytu usług.</p>
    </div>
</header>
@if (Model.Error is not null)
{
    <div class="alert alert--warning" role="alert">@Model.Error</div>
}
<section class="detail-panel grants-form" aria-labelledby="add-grant-heading">
<h2 id="add-grant-heading">Dodaj uprawnienie</h2>
<form method="post" asp-page-handler="Add">
    <div class="form-field">
        <label asp-for="SubjectKind">Typ podmiotu</label>
        <select asp-for="SubjectKind">
            <option value="User">Użytkownik</option>
            <option value="Group">Grupa</option>
        </select>
    </div>
    <div class="form-field">
        <label asp-for="Subject">Konto lub grupa systemu Linux</label>
        <input asp-for="Subject" />
    </div>
    <div class="form-field">
        <label asp-for="Service">Nazwa kanoniczna usługi</label>
        <input asp-for="Service" placeholder="example.service" />
    </div>
    <button type="submit" class="button button--primary">Nadaj Service.View</button>
</form>
</section>

<div class="table-region grants-table" role="region" aria-label="Lista uprawnień" tabindex="0">
<table class="service-table">
    <thead><tr><th scope="col">Podmiot</th><th scope="col">Operacja</th><th scope="col">Usługa</th><th scope="col"><span class="visually-hidden">Akcje</span></th></tr></thead>
    <tbody>
    @foreach (var grant in Model.Grants)
    {
        <tr>
            <td>@grant.SubjectKind: @grant.Subject</td>
            <td>@grant.Operation</td>
            <td>@grant.Service</td>
            <td>
                <form method="post" asp-page-handler="Remove">
                    <input type="hidden" name="GrantId" value="@grant.Id" />
                    <button type="submit" class="button button--danger button--compact">Usuń</button>
                </form>
            </td>
        </tr>
    }
    </tbody>
</table>
</div>
