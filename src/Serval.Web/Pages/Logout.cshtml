@page
@model LogoutModel
@{
    ViewData["Title"] = "Wylogowanie";
}

<section class="simple-panel">
<h1>Wylogowanie</h1>
@if (Model.Error is not null)
{
    <div class="alert alert--danger" role="alert">@Model.Error</div>
}
<form method="post">
    <button type="submit" class="button button--primary">Spróbuj ponownie</button>
</form>
</section>
