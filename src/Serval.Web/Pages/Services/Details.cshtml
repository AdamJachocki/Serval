@page
@model Serval.Web.Pages.Services.DetailsModel
@{
    ViewData["Title"] = "Service details";
}

<h1>Service details</h1>
@if (Model.Error is not null)
{
    <div class="alert alert-warning" role="alert">@Model.Error</div>
}
else if (Model.Service is not null)
{
    <dl class="row">
        <dt class="col-sm-3">Canonical name</dt><dd class="col-sm-9">@Model.Service.Id</dd>
        <dt class="col-sm-3">Description</dt><dd class="col-sm-9">@Model.Service.Description</dd>
        <dt class="col-sm-3">Load</dt><dd class="col-sm-9">@Model.Service.LoadState</dd>
        <dt class="col-sm-3">Active</dt><dd class="col-sm-9">@Model.Service.ActiveState</dd>
        <dt class="col-sm-3">Sub-state</dt><dd class="col-sm-9">@Model.Service.SubState</dd>
    </dl>
    <section id="service-environment" data-service="@Model.Service.Id" aria-labelledby="environment-title">
        <h2 id="environment-title">Środowisko usługi</h2>
        <p>Obsługiwane deklaracje konfiguracji — nie środowisko uruchomionego procesu.</p>
        <form id="environment-token" method="post">@Html.AntiForgeryToken()</form>
        <p id="environment-status" role="status">Wczytywanie środowiska…</p>
        <button id="environment-retry" type="button" class="btn btn-outline-secondary" hidden>Spróbuj ponownie</button>
        <div id="environment-rows"></div>
    </section>
    <script src="~/js/service-environment.js" asp-append-version="true" defer></script>
}
