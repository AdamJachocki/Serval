@page
@model ErrorModel
@{
    ViewData["Title"] = "Błąd";
}

<section class="simple-panel">
<h1>Nie udało się przetworzyć żądania.</h1>
<p class="page-lead">Spróbuj ponownie. Jeśli problem będzie się powtarzał, skontaktuj się z administratorem.</p>

@if (Model.ShowRequestId)
{
    <p>
        <strong>Identyfikator żądania:</strong> <code>@Model.RequestId</code>
    </p>
}
</section>
