## A streamlined .gitignore for modern .NET projects
## including temporary files, build results, and files generated by common tools.

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/
artifacts/
publish/

# IDE and user state
.vs/
.vscode/
.idea/
*.suo
*.user
*.userosscache
*.sln.docstates

# .NET and ASP.NET tooling
project.lock.json
project.fragment.lock.json
ScaffoldingReadMe.txt
appsettings.Local.json
appsettings.*.Local.json

# NuGet packages
*.nupkg
*.snupkg

# Environment and local secrets
.env
.env.*
!.env.example

# Test and coverage results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*
CodeCoverage/
coverage/
coverage.*
*.trx
*.VisualState.xml
TestResult.xml
nunit-*.xml

# Logs and temporary files
*.log
*.binlog
~$*
*~

# Visual Studio
.vs
